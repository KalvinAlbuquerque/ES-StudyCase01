@startuml diagrama_deploy_atualizado
!theme vibrant

title Diagrama de Implantação - Afrodite Calendar (Atualizado)

skinparam linetype ortho
!define DEVICONS https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/devicons
!define FONTAWESOME https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/font-awesome-5
!include DEVICONS/firefox.puml
!include DEVICONS/java.puml
!include FONTAWESOME/server.puml
!include FONTAWESOME/database.puml
!include FONTAWESOME/user_shield.puml

actor "Usuário" as user

node "Dispositivo do Cliente" {
  agent "Browser" as browser <<$firefox>>
}

cloud "Nuvem (Internet)" {
    
    node "Servidor de Aplicação" as app_server <<$server>> {
        artifact "Afrodite Calendar App\n(Spring Boot JAR)" as app <<$java>> {
            component "Frontend Estático\n(HTML, CSS, JS)" as frontend
            component "API REST (Controllers & DTOs)" as api
            component "Lógica de Negócio (Services & Security)" as services
            component "Modelo (Core Logic & Factory)" as core
        }
    }
    
    package "Google Firebase" {
        node "Firebase Authentication" as auth <<$user_shield>>
        database "Cloud Firestore" as firestore <<$database>>
    }
}

user -down-> browser : "1. Acessa a aplicação"

app -up-> browser : "2. Serve arquivos estáticos"
browser -down-> app : "3. Envia requisições para a API REST (com Token JWT)"

app -right-> auth : "4. Valida Token JWT (Admin SDK)"
app -right-> firestore : "5. Lê/Escreve dados dos contatos (Admin SDK)"

note right of app
  A aplicação Spring Boot roda
  no servidor, servindo tanto o 
  frontend quanto a API.
end note

@enduml