@startuml diagrama_de_caso_de_uso_atualizado
' Thema para um visual mais moderno
!theme vibrant

title Afrodite Calendar - Casos de Uso (Atualizado)

actor "Usuário" as user

rectangle "Sistema Afrodite Calendar" {
  usecase "5. Autenticar-se" as UC_AUTH
  usecase "4. Listar Contatos" as UC_LIST
  usecase "1. Adicionar Contato" as UC_ADD
  usecase "2. Buscar Contato" as UC_SEARCH
  usecase "3a. Remover Contato Específico" as UC_REMOVE_ONE
  usecase "3b. Remover Contatos por Inicial" as UC_REMOVE_INITIAL
}

' Ações diretas do usuário
user -- UC_AUTH
user -- UC_ADD
user -- UC_LIST
user -- UC_SEARCH
user -- UC_REMOVE_ONE
user -- UC_REMOVE_INITIAL

@enduml