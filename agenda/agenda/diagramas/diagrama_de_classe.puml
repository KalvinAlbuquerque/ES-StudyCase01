@startuml diagrama_de_classe
' Thema para um visual mais moderno
!theme vibrant

title Diagrama de Classes - Afrodite Calendar 

package "Controllers" {
  class AgendaController {
    - agenda: IF_Agenda
    + listarContatos(...)
    + adicionarContato(...)
    + removerContato(...)
  }

  class AuthController {
    - authService: AuthService
    + handleLogin(...)
  }
}

package "Services & Security" {
  class AuthService {
    - firebaseApiKey: String
    + loginAndGetIdToken(...)
  }

  class FirebaseAuthenticationFilter {
    + doFilterInternal(...)
  }

  class SecurityConfig {
    + securityFilterChain(http)
  }
}

package "Model (Core)" {
  interface IF_Agenda {
    + adicionaContato(uid, contato)
    + getContato(uid, telefone)
    + removeContato(uid, telefone)
    + getListaAgenda(uid)
  }

  interface IF_Contato {
    + getNome()
    + getTelefone()
  }

  class Contato implements IF_Contato {
    - id: String
    - nome: String
    - telefone: String
    - uid: String
  }

  class AgendaMap implements IF_Agenda {
    - COLLECTION_NAME: String
    + adicionaContato(...)
    + getContato(...)
    + removeContato(...)
    + getListaAgenda(...)
  }
}

' Relacionamentos
AgendaController o--> IF_Agenda
AuthController o--> AuthService

AgendaMap ..> "Firebase Firestore" : usa
AuthService ..> "Firebase Authentication API" : usa

note "Configurado via AgendaConfig para\ninjetar a implementação AgendaMap" as N1
N1 .. AgendaController

note bottom of FirebaseAuthenticationFilter
  Valida o Token JWT de cada requisição
  e integra com o Spring Security.
end note

@enduml